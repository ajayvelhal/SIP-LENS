{
  "name": "sip-lens",
  "version": "1.0.0-rc.0",
  "description": "Open-source XIRR portfolio analyser for Indian mutual fund investors. No server. No signup. Drop your CAS PDF.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ajvelhal/sip-lens.git"
  },
  "keywords": [
    "mutual-funds",
    "india",
    "sip",
    "xirr",
    "portfolio-tracker",
    "react",
    "typescript",
    "local-first"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "node scripts/gen-fixtures.mjs --apply",
    "data:refresh": "node scripts/refresh-benchmark.mjs --apply && node scripts/refresh-isin-map.mjs --apply"
  },
  "dependencies": {
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "pdfkit": "^0.17.1",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
